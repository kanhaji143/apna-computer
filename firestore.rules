rules_version = '2';

// Apna Computer Ltd — Firestore Rules
// Clothing CRM + School CRM (demo: public read/write)

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Blog helpers (Phase 7) ----
    // A signed-in admin may do anything to their own blog data.
    function isAdmin() {
      return request.auth != null;
    }

    // A member of the public may only see a post that is:
    //   1) marked published, AND
    //   2) not scheduled for the future (publishAt is a Firestore Timestamp)
    function canReadPublicPost() {
      return resource.data.status == 'published'
             && (!('publishAt' in resource.data) || resource.data.publishAt <= request.time);
    }

    // ---- Blog (Phase 7 — secured with Firebase Auth) ----
    match /bl_posts/{id} {
      allow get:  if isAdmin() || canReadPublicPost();
      allow list: if isAdmin() || canReadPublicPost();

      allow create: if isAdmin();

      // Admin may edit freely. The public may ONLY bump the view counter by exactly 1 —
      // nothing else on the document can change without an admin session.
      allow update: if isAdmin()
                    || (canReadPublicPost()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                        && request.resource.data.views == resource.data.views + 1);

      allow delete: if isAdmin();
    }

    match /bl_categories/{id} { allow read: if true;  allow write: if isAdmin(); }
    match /bl_tags/{id}       { allow read: if true;  allow write: if isAdmin(); }
    match /bl_media/{id}      { allow read: if true;  allow write: if isAdmin(); }
    match /bl_config/{id}     { allow read: if true;  allow write: if isAdmin(); }

    // Newsletter — anyone may opt IN (consent is mandatory and must start as 'pending').
    // Only an admin can read the subscriber list, so emails are never exposed publicly.
    match /bl_subscribers/{id} {
      allow create: if request.resource.data.consent == true
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Contact form — anyone may send a message; only an admin can read the inbox.
    match /bl_messages/{id} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // ---- Clothing CRM ----
    match /cl_products/{id}  { allow read, write: if true; }
    match /cl_suppliers/{id} { allow read, write: if true; }
    match /cl_purchases/{id} { allow read, write: if true; }
    match /cl_sales/{id}     { allow read, write: if true; }
    match /cl_expenses/{id}  { allow read, write: if true; }
    match /cl_staff/{id}     { allow read, write: if true; }
    match /cl_salary/{id}    { allow read, write: if true; }
    match /cl_config/{id}    { allow read, write: if true; }
    match /cl_orders/{id}    { allow read, write: if true; }
    match /cl_reviews/{id}   { allow read, write: if true; }

    // ---- School CRM (JSON data transferred: 2026-10-19) ----
    match /sc_students/{id}         { allow read, write: if true; }
    match /sc_fee_register/{id}     { allow read, write: if true; }
    match /sc_fee_transactions/{id} { allow read, write: if true; }
    match /sc_employees/{id}        { allow read, write: if true; }
    match /sc_transport/{id}        { allow read, write: if true; }
    match /sc_previous_dues/{id}    { allow read, write: if true; }
    match /sc_expenses/{id}         { allow read, write: if true; }
    match /sc_config/{id}           { allow read, write: if true; }
    match /sc_attendance/{id}       { allow read, write: if true; }
    match /sc_exams/{id}           { allow read, write: if true; }
    match /sc_results/{id}         { allow read, write: if true; }

    // ---- Online Center (shop website + CRM) ----
    match /oc_customers/{id}         { allow read, write: if true; }
    match /oc_transactions/{id}      { allow read, write: if true; }
    match /oc_expenses/{id}          { allow read, write: if true; }
    match /oc_service_requests/{id}  { allow read, write: if true; }
    match /oc_ticket_enquiries/{id}  { allow read, write: if true; }
    match /oc_notices/{id}           { allow read, write: if true; }
    match /oc_config/{id}            { allow read, write: if true; }

    // ---- Coaching ERP (Phase 6 — demo: public read/write) ----
    match /ch_students/{id}   { allow read, write: if true; }
    match /ch_batches/{id}    { allow read, write: if true; }
    match /ch_courses/{id}    { allow read, write: if true; }
    match /ch_subjects/{id}   { allow read, write: if true; }
    match /ch_teachers/{id}   { allow read, write: if true; }
    match /ch_timetable/{id}  { allow read, write: if true; }
    match /ch_attendance/{id} { allow read, write: if true; }
    match /ch_invoices/{id}   { allow read, write: if true; }
    match /ch_payments/{id}   { allow read, write: if true; }
    match /ch_staff/{id}      { allow read, write: if true; }
    match /ch_payroll/{id}    { allow read, write: if true; }
    match /ch_expenses/{id}   { allow read, write: if true; }
    match /ch_tests/{id}      { allow read, write: if true; }
    match /ch_results/{id}    { allow read, write: if true; }
    match /ch_users/{id}      { allow read, write: if true; }
    match /ch_config/{id}     { allow read, write: if true; }

    // ---- Hub (website enquiries) ----
    match /hub_leads/{id} {
      allow create: if true;   // public form submit (unchanged)
      // Admin (owner email only) can read leads; update limited to 'status' field only
      allow read: if request.auth != null
                  && request.auth.token.email == 'kanhadigimkt@gmail.com';
      allow update: if request.auth != null
                    && request.auth.token.email == 'kanhadigimkt@gmail.com'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status']);
      allow delete: if false;  // delete always denied (even admin, for now)
    }

    // ---- default: deny ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
